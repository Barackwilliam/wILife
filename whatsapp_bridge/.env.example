# Same long random value as WHATSAPP_BRIDGE_KEY on the Django side.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRIDGE_API_KEY=replace-me

# Where Django runs (inbound messages are forwarded to /agent/whatsapp/baileys/)
DJANGO_URL=https://your-app.onrender.com

# Optional: keep the WhatsApp session in Postgres so redeploys don't need a new QR.
# Supabase -> Settings -> Database -> connection string (URI).
DATABASE_URL=
SESSION_NAME=wilife
