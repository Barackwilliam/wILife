<?xml version="1.0" encoding="UTF-8"?>{% load news_tags %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">{% for a in items %}
  <url>
    <loc>{% absolute a.get_absolute_url %}</loc>
    <lastmod>{{ a.updated_at|date:"c" }}</lastmod>
    <news:news>
      <news:publication><news:name>wILife</news:name><news:language>sw</news:language></news:publication>
      <news:publication_date>{{ a.published_at|date:"c" }}</news:publication_date>
      <news:title>{{ a.title }}</news:title>
    </news:news>
    <image:image><image:loc>{% abs_url a.og_url %}</image:loc></image:image>
  </url>{% endfor %}
</urlset>
